# Copy to .env next to docker-compose.yml (Docker Compose loads it automatically).

# Timezone for recordings and UI clocks (America/Denver for David)
TZ=America/Denver

# Used in config.yml as {FRIGATE_RTSP_PASSWORD} once real cameras use RTSP auth.
# Not the Frigate UI login password (set that in Frigate Settings → Users on port 8971).
FRIGATE_RTSP_PASSWORD=changeme

# Optional Frigate+ API key
# PLUS_API_KEY=

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels).
# Required for: docker compose --profile tunnel up -d
# Or install native Windows cloudflared with the same token (preferred — see REMOTE-ACCESS.md).
# Public hostname in Cloudflare should point at http://localhost:8971 (native) or http://frigate:8971 (Compose profile).
# CLOUDFLARE_TUNNEL_TOKEN=

# After the tunnel hostname exists, set this same URL on the hub Vercel project:
# NEXT_PUBLIC_FRIGATE_URL=https://frigate.yourdomain.com
